# ============================================================================
# Environment Variables สำหรับ ระบบจัดการบันทึกข้อมูลการเดินทางของคนงาน
# วิธีใช้งาน: คัดลอกไฟล์นี้เป็นชื่อ .env แล้วกรอกค่าจาก Supabase Project ของคุณ
# หมายเหตุ: หากยังไม่ได้ใส่ค่า SUPABASE_URL ระบบจะใช้โหมด Local Fallback (SQLite/JSON)
# เพื่อให้สามารถรันทดสอบหน้าเว็บและฟีเจอร์ทั้งหมดในเครื่องได้ทันทีโดยไม่เกิด Error
# ============================================================================

PORT=3000
TOKEN_SECRET=worker-dispatch-secret-key-2026

# 1. ตั้งค่าการเชื่อมต่อฐานข้อมูลคลาวด์ Supabase (PostgreSQL Cloud)
# คัดลอกจากเมนู Project Settings -> API ใน Supabase Dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2. ตั้งค่าเริ่มต้นสำหรับ Cartrack Fleet GPS API (สามารถตั้งค่าผ่านหน้าเว็บหลังบ้านได้เช่นกัน)
CARTRACK_API_URL=https://fleetapi-th.cartrack.com/rest/vehicles/status
CARTRACK_USERNAME=
CARTRACK_API_KEY=
CARTRACK_MOCK_MODE=true

# 3. ขีดจำกัดจำนวนรายการบันทึกสูงสุด (Storage Quota Limit)
MAX_STORAGE_LIMIT=100
